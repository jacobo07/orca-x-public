shamefully-hoist=true
minimum-release-age=4320
# Windows MAX_PATH: node-pty's winpty-agent objects land at 263 chars from this repo path,
# three over the limit, so cl.exe fails with an empty compiler-generated filename. Shortening
# the virtual store dir name buys ~29 characters. No effect on other platforms.
virtual-store-dir-max-length=30