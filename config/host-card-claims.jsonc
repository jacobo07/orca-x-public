// Everything the phone's host card SAYS about a host's power, its Orca and its capabilities, and
// every control it draws. Checked by config/scripts/check-host-card-claims.mjs (pnpm
// check:host-card-claims).
//
// A label is one key of HOST_CARD_LABELS in the presenter, "<family>.<suffix>", where the suffix is
// a state of the model (src/shared/host-availability.ts). Each is classified here with:
//   producer      "path#export" that decides the state, imported by the presenter;
//   hostProducer  optional "path#export" on the host that announces it;
//   evidence      the HOST_EVIDENCE_KINDS that can back the state — [] for an unknown, which must
//                 SAY unknown, and [] for a name (a capability's title proves nothing by itself);
//   why           one sentence someone can disagree with.
//   observer      wake.* only: broker, target or phone; target only on host-announced/runtime-ready.
// wakeModel is the module whose HOST_WAKE_* arrays are the wake.* suffixes (G7).
// A control is a pressable in the card, identified by its literal testID, classified with:
//   kind          "navigation" (phone-local, no effect wording) or "effect" (names `rpc`, a host RPC
//                 method that exists);
//   why           as above.
// hostCapabilities classifies every HOST_CAPABILITY_IDS member for G6
// (config/scripts/host-capability-producer-gate.mjs):
//   producer      "path" (whole file) or "path#function", the host code that decides the value;
//   supported     null when it must never read supported, or { evidence, why } naming the
//                 HOST_EVIDENCE_KINDS that producer quotes beside its supported value: in the
//                 `evidence` property of the same object literal, inline or through an identifier
//                 declared in that module with an object literal quoting the kind. Comments are
//                 stripped string- and regex-aware; supported is caught as a quoted, template,
//                 quoted-key, module-constant or shorthand-local value. Known limits (a scan, not a
//                 parser): a constant imported from another module, a computed or spread value, and
//                 an evidence identifier reassigned after its declaration are not followed;
//   emitters      every other "path" or "path#function" that constructs the value status.get serves
//                 (a probe wrapper), scanned under the same supported rule; [] when there is none;
//   why           as above.
//
// Unreachable is not powered off, and no button exists without a backend effect (D-10).
{
  "card": "mobile/src/components/MobileHostCard.tsx",
  "presenter": "mobile/src/components/host-availability-presentation.ts",
  "model": "src/shared/host-availability.ts",
  "wakeModel": "src/shared/host-wake.ts",
  "rpcMethodsDir": "src/main/runtime/rpc/methods",
  "labels": {
    "power.awake": {
      "producer": "src/shared/host-availability.ts#composeHostAvailability",
      "evidence": ["live-response"],
      "why": "Awake only when the host answered status.get on the current connection; an answer is the proof the machine is running"
    },
    "power.unknown": {
      "producer": "src/shared/host-availability.ts#composeHostAvailability",
      "evidence": [],
      "why": "No live response is unknown, and unreachable is not powered off (D-02): silence never names a power state"
    },
    "orca.service-ready": {
      "producer": "src/shared/host-availability.ts#composeHostAvailability",
      "evidence": ["live-response"],
      "why": "A serve host with a ready graph has no window to open, so ready is the whole service (D-03)"
    },
    "orca.runtime-ready": {
      "producer": "src/shared/host-availability.ts#composeHostAvailability",
      "evidence": ["live-response"],
      "why": "A ready graph from a desktop host that reported no window status: the runtime is proven, the window is not"
    },
    "orca.ui-open": {
      "producer": "src/shared/host-availability.ts#composeHostAvailability",
      "evidence": ["live-response"],
      "why": "The host itself reported its window available in the live answer"
    },
    "orca.ui-closed": {
      "producer": "src/shared/host-availability.ts#composeHostAvailability",
      "evidence": ["live-response"],
      "why": "A ready graph with a recognized closed window status; the runtime runs without a visible window"
    },
    "orca.starting": {
      "producer": "src/shared/host-availability.ts#composeHostAvailability",
      "evidence": ["live-response"],
      "why": "The host answered that its graph is reloading, which is starting, not ready and not down"
    },
    "orca.version-mismatch": {
      "producer": "src/shared/host-availability.ts#composeHostAvailability",
      "evidence": ["live-response"],
      "why": "The live answer's protocol versions fail the phone's compat rule, so nothing else in it is trusted"
    },
    "orca.unavailable": {
      "producer": "src/shared/host-availability.ts#composeHostAvailability",
      "evidence": ["live-response"],
      "why": "The host answered and said its graph is unavailable; that is the host's own report, not a guess"
    },
    "orca.unknown": {
      "producer": "src/shared/host-availability.ts#composeHostAvailability",
      "evidence": [],
      "why": "No live response or an unrecognized graph status is unknown; the card never infers Orca is down"
    },
    "capability.can-start-orca": {
      "producer": "src/shared/host-availability.ts#HOST_CAPABILITY_IDS",
      "evidence": [],
      "why": "A capability title is a name; its value line carries the claim and the evidence"
    },
    "capability.can-wake-lan": {
      "producer": "src/shared/host-availability.ts#HOST_CAPABILITY_IDS",
      "evidence": [],
      "why": "Naming LAN wake is not offering it: the Wake control is offered only from a bound broker's answer this session, never from this announced value"
    },
    "capability.can-wake-remote": {
      "producer": "src/shared/host-availability.ts#HOST_CAPABILITY_IDS",
      "evidence": [],
      "why": "Naming remote wake is not offering it: the Wake control is offered only from a bound broker's answer this session, never from this announced value"
    },
    "capability.can-power-on-oob": {
      "producer": "src/shared/host-availability.ts#HOST_CAPABILITY_IDS",
      "evidence": [],
      "why": "Naming out-of-band power-on is not offering it; the OOB probe never reads supported (unknown on Intel and on AMD, since a CPU vendor proves no AMT but not the absence of DASH or a BMC)"
    },
    "capability.can-relay": {
      "producer": "src/shared/host-availability.ts#HOST_CAPABILITY_IDS",
      "evidence": [],
      "why": "A capability title is a name; its value line carries the claim and the evidence"
    },
    "capability.can-direct": {
      "producer": "src/shared/host-availability.ts#HOST_CAPABILITY_IDS",
      "evidence": [],
      "why": "A capability title is a name; its value line carries the claim and the evidence"
    },
    "capability-value.supported": {
      "producer": "src/shared/host-availability.ts#parseHostAvailabilityAnnouncement",
      "hostProducer": "src/main/runtime/host-availability-producer.ts#createHostAvailabilityProducer",
      "evidence": ["host-announced", "relay-reported", "os-probe"],
      "why": "Supported only when the host announced it with evidence; the parser degrades an unevidenced entry to unknown"
    },
    "capability-value.not-supported": {
      "producer": "src/shared/host-availability.ts#parseHostAvailabilityAnnouncement",
      "hostProducer": "src/main/runtime/host-availability-producer.ts#createHostAvailabilityProducer",
      "evidence": ["host-announced", "os-probe"],
      "why": "Not possible is the host's own statement about its build or platform, never the phone's guess; the WOL probe states it only when it read every Ethernet adapter's magic-packet setting, and the OOB probe never states it (an AMD vendor proves no AMT, not the absence of DASH or a BMC)"
    },
    "capability-value.not-configured": {
      "producer": "src/shared/host-availability.ts#parseHostAvailabilityAnnouncement",
      "hostProducer": "src/main/runtime/host-availability-producer.ts#createHostAvailabilityProducer",
      "evidence": ["host-announced", "os-probe"],
      "why": "Not set up comes from the host's announcement or its OS probe (the logon autostart entry)"
    },
    "capability-value.needs-owner-setup": {
      "producer": "src/shared/host-availability.ts#parseHostAvailabilityAnnouncement",
      "hostProducer": "src/main/runtime/host-availability-producer.ts#createHostAvailabilityProducer",
      "evidence": ["host-announced", "os-probe"],
      "why": "Needs setup is announced by the host when only the Owner can complete the step; the WOL probe reports it when a capable adapter is not armed for wake"
    },
    "capability-value.unknown": {
      "producer": "src/shared/host-availability.ts#parseHostAvailabilityAnnouncement",
      "evidence": [],
      "why": "An old host, a malformed entry or a missing evidence object all read as unknown (D-05)"
    },
    "capabilities.unknown": {
      "producer": "src/shared/host-availability.ts#unknownHostCapabilities",
      "evidence": [],
      "why": "With no status this session, or every capability unknown, one line says so instead of six guesses"
    },
    "wake.requested": {
      "producer": "src/shared/host-wake.ts#composeWakeProgress",
      "evidence": ["live-response"],
      "observer": "broker",
      "why": "The broker answered that it recorded the request; that is the broker's word, not the host's"
    },
    "wake.authorized": {
      "producer": "src/shared/host-wake.ts#composeWakeProgress",
      "evidence": ["live-response"],
      "observer": "broker",
      "why": "The broker answered that this paired device holds a grant for the target; nothing reached the host yet"
    },
    "wake.packet-sent": {
      "producer": "src/shared/host-wake.ts#composeWakeProgress",
      "evidence": ["live-response"],
      "observer": "broker",
      "why": "The broker answered that its socket sent the magic packet; a packet sent is not a host woken"
    },
    "wake.packet-send-failed": {
      "producer": "src/shared/host-wake.ts#composeWakeProgress",
      "evidence": ["live-response"],
      "observer": "broker",
      "why": "The broker answered that its send failed, so the card says the packet did not leave rather than guessing"
    },
    "wake.host-announced": {
      "producer": "src/shared/host-wake.ts#composeWakeProgress",
      "evidence": ["live-response"],
      "observer": "target",
      "why": "Only the target's own status answer, on a connection made after the press and observed after the press reply, says the host answered"
    },
    "wake.runtime-ready": {
      "producer": "src/shared/host-wake.ts#composeWakeProgress",
      "evidence": ["live-response"],
      "observer": "target",
      "why": "Only the target's own status answer after the press reply, with a ready graph, says its Orca runtime is ready"
    },
    "wake.wake_broker_disabled": {
      "producer": "src/shared/host-wake.ts#HOST_WAKE_REFUSAL_CODES",
      "evidence": ["live-response"],
      "observer": "broker",
      "why": "The broker refused because its Owner has not enabled wake brokering; that is its answer, shown as its own state"
    },
    "wake.wake_broker_unavailable": {
      "producer": "src/shared/host-wake.ts#HOST_WAKE_REFUSAL_CODES",
      "evidence": ["live-response"],
      "observer": "broker",
      "why": "The broker refused because its wake store could not serve the request; the target's state is not implied"
    },
    "wake.wake_device_required": {
      "producer": "src/shared/host-wake.ts#HOST_WAKE_REFUSAL_CODES",
      "evidence": ["live-response"],
      "observer": "broker",
      "why": "The broker refused a caller that is not a paired device; only a paired phone may ask"
    },
    "wake.wake_device_revoked": {
      "producer": "src/shared/host-wake.ts#HOST_WAKE_REFUSAL_CODES",
      "evidence": ["live-response"],
      "observer": "broker",
      "why": "The broker refused because this phone's pairing was revoked; re-pairing is the fix, not a retry"
    },
    "wake.wake_device_unauthorized": {
      "producer": "src/shared/host-wake.ts#HOST_WAKE_REFUSAL_CODES",
      "evidence": ["live-response"],
      "observer": "broker",
      "why": "The broker refused because the device token and the device do not belong together"
    },
    "wake.wake_device_unknown": {
      "producer": "src/shared/host-wake.ts#HOST_WAKE_REFUSAL_CODES",
      "evidence": ["live-response"],
      "observer": "broker",
      "why": "The broker refused because it does not know this device at all"
    },
    "wake.wake_grant_missing": {
      "producer": "src/shared/host-wake.ts#HOST_WAKE_REFUSAL_CODES",
      "evidence": ["live-response"],
      "observer": "broker",
      "why": "The broker refused because this device holds no grant for the bound target; the Owner grants it"
    },
    "wake.wake_target_unknown": {
      "producer": "src/shared/host-wake.ts#HOST_WAKE_REFUSAL_CODES",
      "evidence": ["live-response"],
      "observer": "broker",
      "why": "The broker refused because the target id is no longer in its store, so the binding is stale"
    },
    "wake.wake_target_rebound": {
      "producer": "src/shared/host-wake.ts#HOST_WAKE_REFUSAL_CODES",
      "evidence": ["live-response"],
      "observer": "broker",
      "why": "The broker refused because the target is now bound to a host key other than this card's, so it sent nothing rather than wake another host"
    },
    "wake.wake_send_failed": {
      "producer": "src/shared/host-wake.ts#HOST_WAKE_REFUSAL_CODES",
      "evidence": ["live-response"],
      "observer": "broker",
      "why": "The broker refused after its send path failed; distinct from a recorded packet-send-failed stage"
    },
    "wake.wake_unknown": {
      "producer": "src/shared/host-wake.ts#HOST_WAKE_REFUSAL_CODES",
      "evidence": ["live-response"],
      "observer": "broker",
      "why": "The broker answered that it holds no record for this wake id, which is its answer and not a state of the host"
    },
    "wake.wake_broker_state_indeterminate": {
      "producer": "src/shared/host-wake.ts#HOST_WAKE_REFUSAL_CODES",
      "evidence": ["live-response"],
      "observer": "broker",
      "why": "The broker refused because it could not confirm its own state, so it sent nothing rather than risk a duplicate"
    },
    "wake.unknown": {
      "producer": "src/shared/host-wake.ts#HOST_WAKE_CARD_STATES",
      "evidence": [],
      "observer": "phone",
      "why": "An unreadable broker answer or an unlisted refusal code is unknown; the phone never maps it to a nearby state"
    },
    "wake.ambiguous-broker": {
      "producer": "src/shared/host-wake-proxy.ts#composeHostWakeRoute",
      "evidence": ["live-response"],
      "observer": "phone",
      "why": "Two brokers answered this session with a binding for this host, so the phone refuses to guess and draws no control"
    }
  },
  "actions": {
    "host-card-open": {
      "kind": "navigation",
      "why": "Opens the host screen on the phone and sends no host effect"
    },
    "host-card-wake": {
      "kind": "effect",
      "rpc": "host.wake.request",
      "why": "Asks the one broker that answered this session with a binding for this host's key to send the magic packet; drawn only from that answer"
    },
    "host-card-actions": {
      "kind": "navigation",
      "why": "Opens the phone-side sheet, whose reconnect, edit and remove are phone-local"
    }
  },
  "hostCapabilities": {
    "can-start-orca": {
      "producer": "src/main/runtime/host-autostart-probe.ts#capabilityFromStatus",
      "emitters": ["src/main/runtime/host-autostart-probe.ts"],
      "supported": {
        "evidence": ["os-probe"],
        "why": "Supported only from an installed logon task the OS itself reported in a ready, running or queued state"
      },
      "why": "Start-on-logon is read from the OS task scheduler, never assumed from a build flag"
    },
    "can-wake-lan": {
      "producer": "src/main/runtime/host-wol-verdict.ts",
      "emitters": ["src/main/runtime/host-wol-probe.ts"],
      "supported": null,
      "why": "Only an observed wake proves LAN wake and that is OWNER_BOUND, so the WOL verdict has no supported branch"
    },
    "can-wake-remote": {
      "producer": "src/main/runtime/host-availability-producer.ts#describeRemoteWakeCapability",
      "emitters": [],
      "supported": null,
      "why": "Option B: a broker serves wake targets and is not one; the phone learns acceptance from host.wake-broker.v1 and host.wake.targets"
    },
    "can-power-on-oob": {
      "producer": "src/main/runtime/host-oob-verdict.ts",
      "emitters": ["src/main/runtime/host-oob-probe.ts"],
      "supported": null,
      "why": "No out-of-band controller is ever proven by a CPU-vendor read, so the OOB verdict never reads supported and an AMD vendor reads unknown"
    },
    "can-relay": {
      "producer": "src/main/runtime/host-availability-producer.ts#describeRelayCapability",
      "emitters": [],
      "supported": {
        "evidence": ["relay-reported"],
        "why": "Supported only once the relay itself reported a status for this host"
      },
      "why": "Relay reachability comes from the host's relay readiness, never from the phone"
    },
    "can-direct": {
      "producer": "src/main/runtime/host-availability-producer.ts#describeDirectCapability",
      "emitters": [],
      "supported": {
        "evidence": ["host-announced"],
        "why": "Supported only when the host announces a WebSocket listener bound beyond loopback"
      },
      "why": "Direct reachability is the host's own listener endpoint; a loopback bind is not configured"
    }
  }
}
