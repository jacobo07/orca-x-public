// Recurring work in src/, classified by what multiplies it (Resource Elasticity R4).
// Enforced by `pnpm check:recurring-work` (config/scripts/check-recurring-work-inventory.mjs).
//
// Each key is a site the sweep found: <file>#<kind>#<enclosing symbol>[#n]. Renaming or moving the
// symbol changes the key, so the site must be classified again — that is deliberate.
//
// Fields:
//   responsibility  kebab id; several sites can share one
//   cadence         e.g. "750ms-15s tiered", "10s", "backoff 1s-30s", "per frame", "unknown"
//   lifetime        persistent | while-active | bounded (stops by itself after finite work)
//   scaling         what multiplies it: global, per-process, per-window, per-host are constant;
//                   everything else (per-worktree, per-live-pty, per-subscriber, ...) multiplies
//   hidden          paused | runs | n/a | unknown   (window/pane hidden)
//   dormant         none | runs | n/a | unknown     (subject has no live runtime)
//   spawns          none | the binary it launches | unknown
//   disposition     justified | debt   (debt responsibilities must be listed in
//                   config/recurring-work-debt-baseline.txt, which may only shrink)
//   bound           required for a justified, non-bounded, multiplicative producer: what caps it
//   note            one line of evidence
{
  // Schedulers that take their callback as an argument; the sweep classifies their call sites.
  "helpers": [
    "installWindowVisibilityInterval",
    "installWindowVisibilityTimeoutPoller",
    "RelayDrainRetrySchedule",
    "useNow",
    "usePromptCacheCountdownNow",
    "createCoalescedPollRunner",
    "RemoteBrowserStreamRestartScheduler",
    "startWindowsTerminalCapabilityReprobe",
    "createTaskbarPreviewRefreshTicker",
    "startRemoteRuntimeSocketLiveness"
  ],
  "sites": {
    "src/cli/handlers/orchestration.ts#interval#startCheckKeepalive": {
      "responsibility": "orchestration-cli-stderr-keepalive",
      "cadence": "15s (env-overridable)",
      "lifetime": "while-active",
      "scaling": "per-process",
      "hidden": "n/a",
      "dormant": "n/a",
      "spawns": "none",
      "disposition": "justified",
      "note": "orchestration.ts:58 - unref'd interval, cleared by returned dispose fn; one per CLI subprocess invocation"
    },
    "src/cli/runtime/mac-app-update-bundle.ts#interval#waitForMacBundleVersion": {
