// Combined-tree gate manifest (schema combined-tree-gate/1), read by
// config/scripts/combined-tree-gate-contract.mjs and run by config/scripts/combined-tree-gate.sh.
//
// The expected spec, unit-group and gate NAMES and their passed floors come from here, not from the
// run: a spec dropped from a run, duplicated in it, or skipped wholesale (exit 0, "2 skipped") reads
// RED. Floors were measured at the Phase 1 closure tip 05b57a67c on the Linux test plane.
// A later phase extends the spine by editing this file in its own commit.
{
  "schema": "combined-tree-gate/1",
  // Closure branch cut point = the integration-3 baseline; oxlint/oxfmt judge files changed since it.
  "changedFilesBase": "741ca9985",
  "specEnv": { "MISSION_BRIEF_VISUAL": "1" },
  // Unset, mission-brief skips both tests and exits 0, so the runner refuses instead of running.
  "requiredEnv": [{ "name": "MISSION_BRIEF_REPOS", "pathList": true }],
  "specs": [
    { "name": "force-reload-renderer-replacement", "minPassed": 3 },
    // R-05: seen red on d3d85fa63 (p8-01-red-0b3278fb8), 3/3 green at d34d33584 (p8-01-green-d34d33584).
    { "name": "window-close-survivor-terminal-output", "minPassed": 1 },
    { "name": "reload-freeze-frame", "minPassed": 4 },
    { "name": "renderer-crash-recovery-terminal-input", "minPassed": 1 },
    { "name": "resume-center-r01-reality", "minPassed": 1 },
    { "name": "resume-center-snapshots", "minPassed": 1 },
    { "name": "resume-center-open-in", "minPassed": 1 },
    { "name": "resume-center", "minPassed": 1 },
    { "name": "resume-center-mission-discovery", "minPassed": 1 },
    { "name": "resume-center-restore-no-wake", "minPassed": 1 },
    { "name": "resume-center-resume", "minPassed": 1 },
    { "name": "mission-brief", "minPassed": 2 },
    { "name": "workspace-navigation-convergence", "minPassed": 1 },
    { "name": "global-nav-shell-stability", "minPassed": 2 },
    { "name": "project-working-set-restore-surface", "minPassed": 1 }
  ],
  "unitGroups": [
    {
      "name": "gate9",
      "paths": [
        "src/main/window",
        "src/main/renderer-replacement-wiring.test.ts",
        "src/main/menu/register-app-menu.test.ts",
        "src/main/ipc/pty-multi-window-lifecycle-reset.test.ts",
        "src/renderer/src/components/resume-center",
        "src/renderer/src/store/slices/ui-notice-dismissals.test.ts",
        "src/main/runtime/rpc/methods/client-ui.test.ts"
      ],
      "minPassedFiles": 69
    },
    {
      "name": "closure",
      "paths": [
        "tests/e2e/helpers/terminal-output-line.unit.test.ts",
        "tests/e2e/helpers/terminal-probe-marker.unit.test.ts",
        "config/scripts/check-e2e-terminal-liveness-probes.test.mjs",
        "config/scripts/combined-tree-gate-contract.test.mjs",
        "config/scripts/combined-tree-gate-manifest.test.mjs",
        "config/scripts/combined-tree-gate-runner.test.mjs"
      ],
      "minPassedFiles": 6
    },
    {
      "name": "pty",
      "paths": ["src/main/ipc/pty"],
      "minPassedFiles": 70,
      "regressionDiff": true,
      // The 741ca9985 baseline failure list measured NONE, so exit must be 0 and regressions 0.
      // Entries, when recorded, are "<file relative to the repo root>::<full test name>" (a suite error, ::FILE_FAILED, is never excusable).
      "knownFailures": []
    }
  ],
  "staticGates": [
    {
      "name": "tsc-node",
      "argv": [
        "node",
        "node_modules/typescript/bin/tsc",
        "--noEmit",
        "-p",
        "config/tsconfig.node.json"
      ]
    },
    {
      "name": "tsc-web",
      "argv": [
        "node",
        "node_modules/typescript/bin/tsc",
        "--noEmit",
        "-p",
        "config/tsconfig.tc.web.json"
      ]
    },
    { "name": "oxlint", "argv": ["node_modules/.bin/oxlint"], "changedFiles": true },
    { "name": "oxfmt", "argv": ["node_modules/.bin/oxfmt", "--check"], "changedFiles": true },
    {
      "name": "e2e-terminal-liveness",
      "argv": ["node", "config/scripts/check-e2e-terminal-liveness-probes.mjs"]
    },
    {
      "name": "e2e-fixture-binding",
      "argv": ["node", "config/scripts/check-e2e-fixture-binding.mjs"]
    },
    { "name": "ci-gate-coverage", "argv": ["node", "config/scripts/check-ci-gate-coverage.mjs"] },
    { "name": "max-lines-ratchet", "argv": ["node", "config/scripts/check-max-lines-ratchet.mjs"] },
    {
      "name": "recurring-work",
      "argv": ["node", "config/scripts/check-recurring-work-inventory.mjs"]
    }
  ]
}
